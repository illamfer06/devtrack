    if (response.status === 200 && match) {
        client.global.set("anaSessionId2", match[1]);
        client.global.clear("anaCsrf2");
        client.log("Sesión 2 renovada; obtener CSRF nuevo en paso 10.");
    } else {
        client.log("ERROR: login 2 fallido o sin nueva cookie; no continúes.");
