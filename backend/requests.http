Cookie: JSESSIONID={{anaPostDeleteSession}}
X-CSRF-TOKEN: {{anaPostDeleteCsrf}}
Content-Type: application/json
Accept: application/json

{
  "email": "ana.devtrack.test@example.com",
  "password": "AnaPass123!"
}


### ============================
### 2. BOB — SESIÓN INDEPENDIENTE
### ============================
# NO reutilizamos la cookie de Ana. Las variables anaSessionId y bobSessionId
# permiten ir alternando de usuario sin mezclar sus sesiones.

### BOB - Obtener CSRF y sesión anónima
// @no-cookie-jar
GET {{baseUrl}}/auth/csrf

> {%
    const setCookie = response.headers.valueOf("Set-Cookie");
    const match = setCookie
        ? setCookie.match(/JSESSIONID=([^;]+)/)
        : null;

    if (match) {
        client.global.set("bobSessionId", match[1]);
    }

    client.global.set("bobCsrf", response.body.token);

    client.log("Bob session saved: " +
        Boolean(client.global.get("bobSessionId")));

    client.log("Bob CSRF saved: " +
        Boolean(client.global.get("bobCsrf")));
%}

### BOB — Registrar cuenta (201)
// @no-cookie-jar
POST {{baseUrl}}/auth/register
Cookie: JSESSIONID={{bobSessionId}}
X-CSRF-TOKEN: {{bobCsrf}}
Content-Type: application/json
Accept: application/json

{
  "email": "bob.devtrack.test@example.com",
  "password": "BobPass123!"
}

### BOB — Login correcto (200)
POST {{baseUrl}}/auth/login
Cookie: JSESSIONID={{bobSessionId}}
X-CSRF-TOKEN: {{bobCsrf}}
Content-Type: application/json
Accept: application/json

{
  "email": "bob.devtrack.test@example.com",
  "password": "BobPass123!"
}

> {%
const setCookie = response.headers.valueOf("Set-Cookie");
if (setCookie) {
  const match = setCookie.match(/JSESSIONID=([^;]+)/);
  if (match) client.global.set("bobSessionId", match[1]);
}
%}

### BOB — Renovar CSRF después del login
GET {{baseUrl}}/auth/csrf
Cookie: JSESSIONID={{bobSessionId}}

> {%
const setCookie = response.headers.valueOf("Set-Cookie");
if (setCookie) {
  const match = setCookie.match(/JSESSIONID=([^;]+)/);
  if (match) client.global.set("bobSessionId", match[1]);
}
client.global.set("bobCsrf", response.body.token);
%}

### BOB — Consultar /auth/me (200)
GET {{baseUrl}}/auth/me
Cookie: JSESSIONID={{bobSessionId}}

### ANA — Verificar que su sesión sigue siendo Ana (200)
GET {{baseUrl}}/auth/me
Cookie: JSESSIONID={{anaSessionId}}

