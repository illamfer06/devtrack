POST {{baseUrl}}/auth/login
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "email": "ana.devtrack.test@example.com",
  "password": "WrongPassword123"
}


### 5. ANA — Login correcto SESIÓN 1 (200); guardar JSESSIONID renovado
// @no-cookie-jar
POST {{baseUrl}}/auth/login
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "email": "  ANA.DEVTRACK.TEST@EXAMPLE.COM  ",
  "password": "AnaPass123!"
}

> {%
    const cookie = response.headers.valueOf("Set-Cookie");
    const match = cookie ? cookie.match(/JSESSIONID=([^;]+)/) : null;
    if (response.status === 200 && match) {
        client.global.set("anaSessionId", match[1]);
        client.global.clear("anaCsrf");
        client.log("Sesión 1 renovada; obtener CSRF nuevo en paso 6.");
    } else {
        client.log("ERROR: login 1 fallido o sin nueva cookie; no continúes.");
    }
%}


### 6. ANA — CSRF NUEVO de la sesión 1 después del login (200)
// @no-cookie-jar
GET {{baseUrl}}/auth/csrf
Cookie: JSESSIONID={{anaSessionId}}
Accept: application/json

> {%
    if (response.status === 200 && response.body.token) {
        client.global.set("anaCsrf", response.body.token);
        client.log("CSRF 1 renovado correctamente.");
    }
%}


### 7. ANA — /auth/me en sesión 1 (200)
// @no-cookie-jar
GET {{baseUrl}}/auth/me
Cookie: JSESSIONID={{anaSessionId}}
Accept: application/json


### 8. ANA — Sesión 2 INDEPENDIENTE: obtener otra sesión anónima y CSRF
// @no-cookie-jar
GET {{baseUrl}}/auth/csrf
Cookie: JSESSIONID=invalid-ana-session-2
Accept: application/json

> {%
    const cookie = response.headers.valueOf("Set-Cookie");
    const match = cookie ? cookie.match(/JSESSIONID=([^;]+)/) : null;
    if (response.status === 200 && match && response.body.token) {
        client.global.set("anaSessionId2", match[1]);
        client.global.set("anaCsrf2", response.body.token);
    } else {
        client.log("ERROR: no se pudo guardar sesión 2 y su CSRF; revisa Set-Cookie.");
    }
    client.log("Sesión 2 guardada: " + Boolean(client.global.get("anaSessionId2")));
    client.log("CSRF 2 guardado: " + Boolean(client.global.get("anaCsrf2")));
    client.log("Sesiones distintas: " + (client.global.get("anaSessionId") !== client.global.get("anaSessionId2")));
%}


