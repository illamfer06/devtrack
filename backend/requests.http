### ============================
### HEALTH
### ============================

### Health
GET http://localhost:8080/health

### ============================
### STUDY BLOCKS
### ============================

### Create study block
POST http://localhost:8080/study-blocks
Content-Type: application/json
Accept: application/json

{
  "title": "Java",
  "active": false
}

### Create study block - Empty title (400 Bad Request)
POST http://localhost:8080/study-blocks
Content-Type: application/json
Accept: application/json

{
  "title": "",
  "active": true
}

### Create study block - Bad Active
POST http://localhost:8080/study-blocks
Content-Type: application/json
Accept: application/json

{
  "title": "Python",
  "active": "invalid"

}
### Get study blocks
GET http://localhost:8080/study-blocks

### Get active study blocks
GET http://localhost:8080/study-blocks?active=true

### Get study blocks paginated
GET http://localhost:8080/study-blocks?page=0&size=2

### Get study blocks filtered and sorted
GET http://localhost:8080/study-blocks?active=true&page=0&size=2&sort=id,asc

### Get study blocks - Invalid active
GET http://localhost:8080/study-blocks?active=invalid

### Get study block by id (exists)
GET http://localhost:8080/study-blocks/2

### Get study block by id (not found)
GET http://localhost:8080/study-blocks/99999

### Update study block
PUT http://localhost:8080/study-blocks/2
Content-Type: application/json
Accept: application/json

{
  "title": "Python",
  "active": true
}

### Update non-existing study block
PUT http://localhost:8080/study-blocks/99999
Content-Type: application/json
Accept: application/json

{
  "title": "Python",
  "active": true
}

### Delete existing study block
DELETE http://localhost:8080/study-blocks/2

### Delete non-existing study block
DELETE http://localhost:8080/study-blocks/99999

### ============================
### PROBLEMS
### ============================

### Create Problem
POST http://localhost:8080/study-blocks/2/problems
Content-Type: application/json
Accept: application/json

{
  "title": "Binary Search",
  "difficulty": "EASY",
  "algorithm": "Binary Search",
  "solved": false,
  "notes": "Review left and right limits",
  "url": "https://leetcode.com/problems/binary-search/"
}

### Create Problem with title only
POST http://localhost:8080/study-blocks/2/problems
Content-Type: application/json
Accept: application/json

{
  "title": "Binary Search"
}

### Create Problem study block not found
POST http://localhost:8080/study-blocks/1/problems
Content-Type: application/json
Accept: application/json

{
  "title": "Binary Search",
  "difficulty": "EASY",
  "algorithm": "Binary Search",
  "solved": false,
  "notes": "Review left and right limits",
  "url": "https://leetcode.com/problems/binary-search/"
}

### Create problem - Empty title (400 Bad Request)
POST http://localhost:8080/study-blocks/2/problems
Content-Type: application/json
Accept: application/json

{
  "title": "",
  "difficulty": "EASY",
  "algorithm": "Hash Map",
  "solved": false,
  "notes": "Testing global exception handler",
  "url": "https://leetcode.com/problems/two-sum/"
}

### Create Problem - Bad Difficulty
POST http://localhost:8080/study-blocks/2/problems
Content-Type: application/json
Accept: application/json

{
  "title": "Binary Search",
  "difficulty": "IMPOSSIBLE",
  "algorithm": "Binary Search",
  "solved": false,
  "notes": "Review left and right limits",
  "url": "https://leetcode.com/problems/binary-search/"
}

### Get Problems
GET http://localhost:8080/study-blocks/3/problems

### Get Problems by Difficulty
GET http://localhost:8080/study-blocks/2/problems?difficulty=EASY

### Get Problem by invalid difficulty
GET http://localhost:8080/study-blocks/2/problems?difficulty=IMPOSSIBLE

### Get Problems by Solved
GET http://localhost:8080/study-blocks/2/problems?solved=true

### Get Problems by invalid solved
GET http://localhost:8080/study-blocks/2/problems?solved=invalid

### Get Problems paginated
GET http://localhost:8080/study-blocks/2/problems?page=0&size=3

### Order by id ascending
GET http://localhost:8080/study-blocks/2/problems?page=0&size=10&sort=id,asc

### Order by id descending
GET http://localhost:8080/study-blocks/2/problems?page=0&size=10&sort=id,desc

### Get Problems by Difficulty and Solved paginated order by id ascending
GET http://localhost:8080/study-blocks/2/problems?difficulty=EASY&solved=false&page=0&size=2&sort=id,asc

### Get Problem by id (exists)
GET http://localhost:8080/study-blocks/2/problems/18

### Get Problem by id (Study block not found)
GET http://localhost:8080/study-blocks/99/problems/1

### Get Problem by id (Problem not found in study block)
GET http://localhost:8080/study-blocks/2/problems/99999

### Update problem
PUT http://localhost:8080/study-blocks/2/problems/19
Content-Type: application/json
Accept: application/json

{
  "title": "Longest Substring Without Repeating Characters",
  "difficulty": "MEDIUM",
  "algorithm": "SLIDING_WINDOW",
  "solved": true,
  "notes": "Solved using a sliding window with a HashSet.",
  "url": "https://leetcode.com/problems/binary-search/"
}

### Update non-existing study block
PUT http://localhost:8080/study-blocks/99999/problems/1
Content-Type: application/json
Accept: application/json

{
  "title": "Test",
  "difficulty": "EASY",
  "algorithm": "ARRAY",
  "solved": false,
  "notes": "Test",
  "url": "https://example.com"
}

### Update non-existing problem
PUT http://localhost:8080/study-blocks/1/problems/99999
Content-Type: application/json
Accept: application/json

{
  "title": "Test",
  "difficulty": "EASY",
  "algorithm": "ARRAY",
  "solved": false,
  "notes": "Test",
  "url": "https://example.com"
}

### Delete existing problem
DELETE http://localhost:8080/study-blocks/2/problems/19

### Delete non-existing study block
DELETE http://localhost:8080/study-blocks/99999/problems/19

### Delete non-existing problem
DELETE http://localhost:8080/study-blocks/2/problems/99999




