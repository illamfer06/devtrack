Accept: application/json

{
  "title": "Unauthorized problem"
}

### BOB — Modificar problema de Ana (404)
PUT {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/{{anaProblemId}}
Cookie: JSESSIONID={{bobSessionId}}
X-CSRF-TOKEN: {{bobCsrf}}
Content-Type: application/json
Accept: application/json

{
  "title": "Hijacked",
  "difficulty": "EASY",
  "algorithm": "ARRAY",
  "solved": false,
  "notes": "Should be rejected",
  "url": "https://example.com"
}

### BOB — Eliminar problema de Ana (404)
DELETE {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/{{anaProblemId}}
Cookie: JSESSIONID={{bobSessionId}}
X-CSRF-TOKEN: {{bobCsrf}}

### ANA — Usar problemId de Bob bajo bloque propio (404)
GET {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/{{bobProblemId}}
Cookie: JSESSIONID={{anaSessionId}}

### ANA — No puede borrar su bloque no vacío (409)
DELETE {{baseUrl}}/study-blocks/{{anaBlockId}}
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}

### ============================
### 7. BULK DELETE / CLEAR — PRUEBAS
### ============================
# Para borrar varios IDs se interpolan números (sin comillas) en JSON.
# Estas operaciones son destructivas: ejecutar solamente al final.

### ANA — Bulk: bloque inexistente (404)
POST {{baseUrl}}/study-blocks/99999999/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": [{{anaProblemId}}, {{anaSecondProblemId}}]
}

### ANA — Bulk: problem ID inexistente (404)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": [{{anaProblemId}}, 99999999]
}

### ANA — Bulk: problem pertenece a bloque de Bob (404)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": [{{anaProblemId}}, {{bobProblemId}}]
}

### BOB — Bulk: borrar problemas de Ana mediante su bloque (404)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{bobSessionId}}
X-CSRF-TOKEN: {{bobCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": [{{anaProblemId}}]
}

### ANA — Bulk: lista vacía (400)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": []
}

### ANA — Bulk: IDs nulos (400)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": null
}

### ANA — Bulk: elemento null (400)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": [{{anaProblemId}}, null, {{anaSecondProblemId}}]
}

### BOB — Clear: intentar vaciar bloque de Ana (404)
DELETE {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/clear
Cookie: JSESSIONID={{bobSessionId}}
X-CSRF-TOKEN: {{bobCsrf}}

### ANA — Clear: bloque inexistente (404)
DELETE {{baseUrl}}/study-blocks/99999999/problems/clear
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}

### ANA — Bulk: IDs duplicados (según Set del DTO: se deduplican)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": [{{anaSecondProblemId}}, {{anaSecondProblemId}}]
}

### ANA — Bulk: eliminar un problema (204)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": [{{anaThirdProblemId}}]
}

### ANA — Bulk: eliminar problema restante (204)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems/bulk-delete
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "problemIds": [{{anaProblemId}}]
}

### ANA — Crear dos problemas nuevos antes de Bulk Success (201)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "title": "Quick Sort"
}

> {%
client.global.set("anaBulkProblem1", response.body.id);
%}

### ANA — Crear segundo problema para Bulk Success (201)
POST {{baseUrl}}/study-blocks/{{anaBlockId}}/problems
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "title": "Merge Sort"
}

> {%
client.global.set("anaBulkProblem2", response.body.id);
%}

