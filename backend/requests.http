# DevTrack — IntelliJ HTTP Client
# Ejecutar SECUENCIALMENTE la preparación de Ana, después la de Bob.# Requiere backend ejecutándose en localhost:8080.
# IntelliJ guarda variables con client.global.set durante esta sesión del HTTP Client.
# CUIDADO: pruebas PUT/DELETE/BULK/CLEAR modifican o borran datos de verdad.
# AVISO: DELETE /auth/me elimina la cuenta de Ana y sus StudyBlocks/Problems de verdad.
# Si Ana ya existe: el registro dará 409. Usa otro email de prueba o una cuenta temporal.
# No uses datos reales ni contraseñas de producción en este archivo.
# No copies cookies ni tokens CSRF a otros lugares: se guardan como variables del HTTP Client.
# `@no-cookie-jar` y la cabecera Cookie explícita buscan impedir mezclar sesiones.
@baseUrl = http://localhost:8080

### 0. Health sin sesión: 401 (si /health sigue protegido)
// @no-cookie-jar
GET {{baseUrl}}/health
Cookie: JSESSIONID=invalid-health-session
Accept: application/json


### 1. ANA — Sesión 1: obtener una sesión anónima y CSRF
// @no-cookie-jar
GET {{baseUrl}}/auth/csrf
Cookie: JSESSIONID=invalid-ana-session-1
Accept: application/json

> {%
    const cookie = response.headers.valueOf("Set-Cookie");
    const match = cookie ? cookie.match(/JSESSIONID=([^;]+)/) : null;
    if (response.status === 200 && match && response.body.token) {
        client.global.set("anaSessionId", match[1]);
        client.global.set("anaCsrf", response.body.token);
    } else {
        client.log("ERROR: no se pudo guardar sesión 1 y su CSRF; revisa Set-Cookie y respuesta.");
    }
    client.log("Sesión 1 guardada: " + Boolean(client.global.get("anaSessionId")));
    client.log("CSRF 1 guardado: " + Boolean(client.global.get("anaCsrf")));
%}


### 2. ANA — Registrar cuenta (201); si ya existe: 409
// @no-cookie-jar
POST {{baseUrl}}/auth/register
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "email": "ana.devtrack.test@example.com",
  "password": "AnaPass123!"
}


### 3. ANA — Registro duplicado con mayúsculas y espacios (409)
// @no-cookie-jar
POST {{baseUrl}}/auth/register
Cookie: JSESSIONID={{anaSessionId}}
X-CSRF-TOKEN: {{anaCsrf}}
Content-Type: application/json
Accept: application/json

{
  "email": "  ANA.DEVTRACK.TEST@EXAMPLE.COM  ",
  "password": "AnaPass123!"
